# ==============================================================================
# Palestine & Gaza News AI Bot — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (Free Tiers)
# ------------------------------------------------------------------------------
# Get your free Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
# Free tier includes 15 requests per minute and 1,500 requests per day at $0.00 cost.
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional backup) Free Groq API Key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Image Generation Settings
# ------------------------------------------------------------------------------
# Default is Pollinations.ai (FLUX model) which is 100% free with NO API key needed!
IMAGE_MODEL=flux
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720

# ------------------------------------------------------------------------------
# 3. Google Drive OAuth 2.0 Credentials (For auto-syncing to Drive)
# ------------------------------------------------------------------------------
# Generated automatically by running: python scripts/setup_google_drive.py
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_optional
